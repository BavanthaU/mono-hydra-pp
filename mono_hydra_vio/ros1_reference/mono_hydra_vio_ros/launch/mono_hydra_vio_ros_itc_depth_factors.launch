<launch>
  <arg name="use_sparse_depth_factors" default="false"/>

  <arg if="$(arg use_sparse_depth_factors)"
       name="dataset_name" value="RealSense_RGBD_depth_factors_on"/>
  <arg unless="$(arg use_sparse_depth_factors)"
       name="dataset_name" value="RealSense_RGBD_depth_factors_off"/>

  <arg if="$(arg use_sparse_depth_factors)"
       name="params_folder"
       value="$(find mono_hydra_vio)/params/RealSense_RGBD_depth_factors_on"/>
  <arg unless="$(arg use_sparse_depth_factors)"
       name="params_folder"
       value="$(find mono_hydra_vio)/params/RealSense_RGBD_depth_factors_off"/>

  <arg name="online" default="true"/>
  <arg name="log_output" default="true"/>
  <arg name="verbosity" default="0"/>
  <arg name="debug" default="false"/>
  <arg name="should_use_sim_time" default="true"/>

  <arg name="use_lcd" default="true"/>
  <arg name="lcd_no_optimize" default="false"/>
  <arg name="lcd_no_detection" default="false"/>

  <arg name="odom_frame_id" default="world"/>
  <arg name="map_frame_id" default="map"/>
  <arg name="base_link_frame_id" default="base_link_kimera"/>
  <arg name="left_cam_frame_id" default="left_cam_kimera"/>
  <arg name="right_cam_frame_id" default="right_cam_kimera"/>

  <arg name="viz_type" default="1"/>
  <arg name="use_rviz" default="true"/>
  <arg name="publish_tf" default="true"/>
  <arg name="semantic_labelspace_file"
       default="$(find mono_hydra)/config/label_spaces/nyud20_label_space.yaml"/>

  <arg name="left_cam_topic" default="/camera/color/image_raw"/>
  <arg name="depth_cam_topic" default="/camera/depth_cam/image_raw"/>
  <arg name="semantic_mask_topic" default=""/>
  <arg name="imu_topic" default="/camera/imu"/>
  <arg name="use_external_odom" default="false"/>
  <arg name="external_odom_topic" default=""/>

  <arg name="log_path"
       default="$(find mono_hydra_vio_ros)/output_logs/$(arg dataset_name)"/>

  <include file="$(find mono_hydra_vio_ros)/launch/mono_hydra_vio_ros.launch" pass_all_args="true">
    <arg name="include_pipeline_flags" value="true"/>
    <arg name="params_folder" value="$(arg params_folder)"/>
    <arg name="flags_folder" value="$(arg params_folder)/flags"/>
    <arg name="viz_type" value="$(arg viz_type)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
    <arg name="publish_tf" value="$(arg publish_tf)"/>
    <arg name="log_gt_data" value="false"/>
    <arg if="$(arg log_output)" name="log_output_path" value="$(arg log_path)"/>
    <arg name="left_cam_topic" value="$(arg left_cam_topic)"/>
    <arg name="depth_cam_topic" value="$(arg depth_cam_topic)"/>
    <arg name="semantic_mask_topic" value="$(arg semantic_mask_topic)"/>
    <arg name="imu_topic" value="$(arg imu_topic)"/>
    <arg name="use_external_odom" value="$(arg use_external_odom)"/>
    <arg name="external_odom_topic" value="$(arg external_odom_topic)"/>
    <arg name="semantic_labelspace_file" value="$(arg semantic_labelspace_file)"/>
    <arg name="odom_frame_id" value="$(arg odom_frame_id)"/>
    <arg name="base_link_frame_id" value="$(arg base_link_frame_id)"/>
    <arg name="map_frame_id" value="$(arg map_frame_id)"/>
    <arg name="left_cam_frame_id" value="$(arg left_cam_frame_id)"/>
    <arg name="right_cam_frame_id" value="$(arg right_cam_frame_id)"/>
  </include>
</launch>
