<launch>
  <arg name="dataset_name" default="RealSense_RGBD_RVIO2"/>
  <arg name="params_folder" default="$(find mono_hydra_vio)/params/$(arg dataset_name)"/>
  <arg name="rvio_config" default="$(find rvio2_kimera_bridge)/config/itc_realsense_848x480.yaml"/>

  <arg name="online" default="true"/>
  <arg name="should_use_sim_time" default="true"/>
  <arg name="log_output" default="true"/>
  <arg name="verbosity" default="0"/>
  <arg name="debug" default="false"/>

  <arg name="use_lcd" default="true"/>
  <arg name="lcd_no_optimize" default="true"/>
  <arg name="viz_type" default="1"/>
  <arg name="use_rviz" default="true"/>
  <arg name="publish_tf" default="true"/>
  <arg name="rvio2_publish_tf" default="false"/>
  <arg name="input_pose_frame" default="body"/>

  <arg name="image_topic" default="/camera/color/image_raw"/>
  <arg name="mono_image_topic" default="/rvio2_bridge/cam0/image_raw"/>
  <arg name="depth_topic" default="/camera/depth_cam/image_raw"/>
  <arg name="imu_topic" default="/camera/imu"/>
  <arg name="external_odom_topic" default="/external_odometry"/>
  <arg name="semantic_labelspace_file"
       default="$(find mono_hydra)/config/label_spaces/nyud20_label_space.yaml"/>

  <!-- Match the ITC Hydra flow, which expects the robot trajectory under `odom`
       when `use_gt_frame:=false`. -->
  <arg name="odom_frame_id" default="odom"/>
  <arg name="map_frame_id" default="map"/>
  <arg name="base_link_frame_id" default="base_link_kimera"/>
  <arg name="left_cam_frame_id" default="left_cam_kimera"/>
  <arg name="right_cam_frame_id" default="right_cam_kimera"/>

  <arg name="sequence_name" default="itc_rvio2_side_test"/>
  <arg name="log_path"
       default="$(find mono_hydra_vio_ros)/output_logs/$(arg dataset_name)/$(arg sequence_name)"/>

  <!-- RVIO2 expects a mono image stream. Keep the source RGB topic untouched and
       derive a side-channel mono topic for this experiment only. -->
  <node pkg="rvio2_kimera_bridge"
        type="rgb_to_mono_bridge.py"
        name="rvio2_rgb_to_mono"
        output="screen">
    <param name="input_topic" value="$(arg image_topic)"/>
    <param name="output_topic" value="$(arg mono_image_topic)"/>
  </node>

  <node pkg="rvio2"
        type="rvio2_mono_node"
        name="rvio2_mono_node"
        args="$(arg rvio_config)"
        output="screen">
    <param name="publish_tf" value="$(arg rvio2_publish_tf)"/>
    <remap from="/cam0/image_raw" to="$(arg mono_image_topic)"/>
    <remap from="/imu0" to="$(arg imu_topic)"/>
  </node>

  <!-- RVIO2 publishes q_kG/p_Gk as world_T_body. Forward it directly to Kimera's
       external-odometry input. -->
  <node pkg="rvio2_kimera_bridge"
        type="rvio2_path_to_odometry.py"
        name="rvio2_path_to_odometry"
        output="screen">
    <param name="trajectory_topic" value="/rvio2/trajectory"/>
    <param name="odometry_topic" value="$(arg external_odom_topic)"/>
    <param name="left_camera_params_path" value="$(arg params_folder)/LeftCameraParams.yaml"/>
    <param name="world_frame_id" value="$(arg odom_frame_id)"/>
    <param name="body_frame_id" value="$(arg base_link_frame_id)"/>
    <param name="input_pose_frame" value="$(arg input_pose_frame)"/>
    <param name="publish_velocity" value="false"/>
  </node>

  <!-- Use the stock Kimera RGBD pipeline with a separate params folder so the
       current ITC flow stays unchanged. -->
  <include file="$(find mono_hydra_vio_ros)/launch/mono_hydra_vio_ros.launch">
    <arg name="dataset_name" value="$(arg dataset_name)"/>
    <arg name="params_folder" value="$(arg params_folder)"/>
    <arg name="online" value="$(arg online)"/>
    <arg name="should_use_sim_time" value="$(arg should_use_sim_time)"/>
    <arg name="log_output" value="$(arg log_output)"/>
    <arg name="log_output_path" value="$(arg log_path)"/>
    <arg name="verbosity" value="$(arg verbosity)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="include_pipeline_flags" value="true"/>

    <arg name="use_lcd" value="$(arg use_lcd)"/>
    <arg name="lcd_no_optimize" value="$(arg lcd_no_optimize)"/>
    <arg name="viz_type" value="$(arg viz_type)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
    <arg name="publish_tf" value="$(arg publish_tf)"/>

    <arg name="left_cam_topic" value="$(arg image_topic)"/>
    <arg name="depth_cam_topic" value="$(arg depth_topic)"/>
    <arg name="imu_topic" value="$(arg imu_topic)"/>
    <arg name="use_external_odom" value="true"/>
    <arg name="external_odom_topic" value="$(arg external_odom_topic)"/>
    <arg name="semantic_labelspace_file" value="$(arg semantic_labelspace_file)"/>

    <arg name="odom_frame_id" value="$(arg odom_frame_id)"/>
    <arg name="map_frame_id" value="$(arg map_frame_id)"/>
    <arg name="base_link_frame_id" value="$(arg base_link_frame_id)"/>
    <arg name="left_cam_frame_id" value="$(arg left_cam_frame_id)"/>
    <arg name="right_cam_frame_id" value="$(arg right_cam_frame_id)"/>
  </include>
</launch>
